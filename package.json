{
  "name": "bookmark-manager",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @bookmark-manager/server",
    "dev:web": "npm run dev -w @bookmark-manager/web",
    "build": "npm run build -w @bookmark-manager/shared && npm run build -w @bookmark-manager/web && npm run build -w @bookmark-manager/server",
    "db:migrate": "npm run db:migrate -w @bookmark-manager/server",
    "db:generate": "npm run db:generate -w @bookmark-manager/server"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
