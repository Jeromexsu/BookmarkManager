# Used by docker-compose (both local dev's `db` service and the VPS deploy).
# The `app` container builds its own DATABASE_URL from these pieces (host "db" — the
# docker-compose service name), so you don't need to set DATABASE_URL here.
POSTGRES_USER=bookmarks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookmarks
POSTGRES_PORT=5432

# DeepSeek (OpenAI-compatible) API key for auto-tagging
DEEPSEEK_API_KEY=

# Port the API listens on (also serves the built web app in production)
PORT=3001
